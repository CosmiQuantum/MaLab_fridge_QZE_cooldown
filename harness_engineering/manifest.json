    "harness_engineering/EXPERIMENT_CONTRACTS.md",
    "harness_engineering/ENVIRONMENT_AND_SAFETY.md",
    "harness_engineering/VERIFICATION.md",
    "harness_engineering/PUCQ4_STATE.md",
    "harness_engineering/FAILURE_MODES.md",
    "harness_engineering/SOURCES.md",
    "docs/harness-log.md"
  ],
  "five_defense_layers": {
